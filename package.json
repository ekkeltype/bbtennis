{
  "name": "black-belt-tennis",
  "version": "0.1.0",
  "description": "Black Belt Tennis: a browser tennis match decided by typing.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sim": "node scripts/testSim.mjs",
    "typecheck": "tsc --noEmit -p .",
    "art:export": "node scripts/artExport.mjs",
    "e2e": "node scripts/e2e.mjs",
    "package:itch": "node scripts/packageItch.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
